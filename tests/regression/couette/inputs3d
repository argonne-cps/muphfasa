# Regression test: Plane Couette flow (3-D channel, wall-driven shear).
# Bottom wall (z=lo) stationary (NoSlip); top wall (z=hi) moving at U0
# (MovingWall); periodic in x and y. No pressure gradient.
# Wall-normal is z in 3-D so faverage (which averages along the last
# dimension) returns the z-profile; see test_couette.cpp WALL_DIM.
#
# Steady-state analytic solution: linear velocity profile
#   u(z) = U0 * z/H
# Time-dependent startup (impulsively-started plate, both walls held fixed
# for t<=0, top wall set to U0 for t>0), solving du/dt = nu * d^2u/dz^2:
#   u(z,t)/U0 = z/H + sum_{n=1}^inf [2*(-1)^n/(n*pi)] * sin(n*pi*z/H)
#                     * exp(-n^2*pi^2*nu*t/H^2)
# which is what test_couette.cpp checks the simulated profile against.
#
# H (wall-to-wall distance, lattice units) = grid.ncells[2], per the
# standard halfway-bounce-back convention (wall sits half a cell beyond
# the last fluid node on each side).

# ── Grid ──────────────────────────────────────────────────────────────────
grid.ncells      = 4 4 32     # Nx Ny Nz (periodic in x,y, walls at z=0 and z=H)
grid.max_grid_size = 32
grid.n_ghost     = 1

# ── Simulation ─────────────────────────────────────────────────────────────
# max_step/plot_int chosen so plot_couette.py's default run lands snapshots
# near characteristic times nu*t/H^2 = 0.005, 0.05, 0.5 (H=32, nu_lat=0.1
# below, so H^2/nu_lat=10240): step 50 -> ~0.005, step 500 -> ~0.05,
# step 5000 -> ~0.5 (already near steady state, decay rate pi^2*nu/H^2).
# plot_int=50 is the largest common divisor of those three steps, so they
# all land on an actual output exactly -- convergence.py overrides
# sim.max_step/amr.plot_int/amr.chk_int itself, so this has no effect there.
sim.max_step     = 5000
sim.stop_time    = -1.0      # run to max_step

# ── LBM ────────────────────────────────────────────────────────────────────
lbm.lattice_type = D3Q19

# ── Physical units ─────────────────────────────────────────────────────────
# tau is derived (SimulationImpl ctor) from these via UnitConverter, with
# N_ref = max(grid.ncells) = 32 and the default lattice velocity U_lat=0.1:
#   dx = ref_length/N_ref,  dt = U_lat*dx/ref_velocity
#   nu_lat = ref_viscosity*dt/dx^2 = 0.1 [lattice units]
#   tau = nu_lat/cs2 + 0.5 = 0.8
units.ref_length    = 1.0
units.ref_velocity  = 1.0 # match wall velocity
units.Re            = 32.0 # implies nu = 1/32

# ── Boundary conditions ────────────────────────────────────────────────────
# x: periodic
# y: periodic
# z: NoSlip at z=lo, MovingWall at z=hi with wall velocity (U0, 0, 0)
bc.lo_type = Periodic  Periodic  NoSlip
bc.hi_type = Periodic  Periodic  MovingWall
bc.hiz_Uwall = 1.  0.0  0.0   # (vx, vy, vz) in physical units

# ── Geometry ───────────────────────────────────────────────────────────────
# is_periodic is derived from bc.lo_type/bc.hi_type (GeometryHandler), not
# read from a separate key -- these prob_lo/prob_hi values are only used to
# set the physical domain extents for plotfile output.
geometry.prob_lo    = 0.0  0.0  0.0
geometry.prob_hi    = 0.125  0.125  1.0

# ── Output ─────────────────────────────────────────────────────────────────
amr.plot_int        = 50
amr.chk_int         = 5000
amr.plot_file       = plt
amr.check_file      = chk
