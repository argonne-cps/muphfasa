# Regression test: uniform body force on a fully periodic 2-D box.
# Quiescent start (default initData), no walls: Sum(c f) grows by exactly F per
# step, so after k advance() calls u = k * F / rho and rho stays 1
# (see test_uniform_force.cpp and README.md). Independent of lbm.tau.

grid.ncells      = 8 8
grid.max_grid_size = 8
grid.n_ghost     = 1

sim.max_step     = 29        # test_uniform_force makes max_step+1 advance() calls
sim.stop_time    = -1.0

lbm.lattice_type = D2Q9

units.ref_length    = 1.0
units.ref_velocity  = 1.0
units.Re            = 32.0

# Physical acceleration [m/s^2]. At N=8, Re=32 (tau=0.8) this is F_lat = 4e-4.
forcing.accel = 0.02 -0.01

bc.lo_type = Periodic  Periodic
bc.hi_type = Periodic  Periodic

geometry.prob_lo    = 0.0  0.0
geometry.prob_hi    = 1.0  1.0

amr.plot_int        = 1000
amr.chk_int         = 100000
amr.plot_file       = plt
amr.check_file      = chk
